{
  "name": "dsh-skin",
  "version": "1.2.1",
  "description": "Apple-style glassmorphism skin for DeepSeek Harness (Cordis bundle)",
  "description:zh-CN": "DeepSeek Harness 苹果风格玻璃拟态皮肤组合包（Cordis）",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opsyang2076-cloud/DSH-Skin.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "skin",
    "theme",
    "apple-style",
    "glassmorphism"
  ]
}
